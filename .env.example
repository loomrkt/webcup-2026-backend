NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=generated_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="My App <no-reply@example.com>"

# Frontend
FRONTEND_URL=http://localhost:3000

AUTH_ENABLE_2FA=true

AUTH_REQUIRE_EMAIL_VERIFICATION=true

# OAuth
AUTH_OAUTH=true

MESSAGING_ENABLED=true

MESSAGING_E2EE=true

MESSAGING_REALTIME=true

MESSAGING_GROUPS=true

MESSAGING_PRESENCE=true

MESSAGING_RECEIPTS=true

MESSAGING_TYPING=true

MESSAGING_REPLIES=true

MESSAGING_EDIT_DELETE=true

MESSAGING_SEARCH=false

MESSAGING_BLOCK=true

RBAC_SEED_PERMISSIONS=true

RBAC_DEFAULT_ADMIN_ROLE=true

RBAC_DEFAULT_ADMIN_EMAIL=

RBAC_SEED_SCOPE=full

RBAC_AUDIT_LOG=false
